{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://openbaeseongjin.github.io/baeseongjin/assets/runtime/audio/audio-manifest.schema.json",
    "title": "Baeseongjin runtime audio package",
    "type": "object",
    "additionalProperties": false,
    "required": ["formatVersion", "id", "category", "clips", "cues"],
    "properties": {
        "$schema": { "type": "string" },
        "formatVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/stableId" },
        "category": { "enum": ["gameplay", "ui", "ambience", "bgm"] },
        "generator": { "type": "object" },
        "clips": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/stableId" },
            "additionalProperties": { "$ref": "#/$defs/clip" }
        },
        "cues": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/stableId" },
            "additionalProperties": { "$ref": "#/$defs/cue" }
        }
    },
    "$defs": {
        "stableId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mimeType"],
            "properties": {
                "path": { "type": "string", "minLength": 1 },
                "mimeType": { "enum": ["audio/wav", "audio/ogg", "audio/mpeg", "audio/webm"] }
            }
        },
        "loop": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startSeconds", "endSeconds"],
            "properties": {
                "startSeconds": { "type": "number", "minimum": 0 },
                "endSeconds": { "type": "number", "exclusiveMinimum": 0 }
            }
        },
        "clip": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playback", "channels", "durationSeconds", "sources"],
            "properties": {
                "playback": { "enum": ["buffer", "stream"] },
                "channels": { "enum": ["mono", "stereo"] },
                "durationSeconds": { "type": "number", "minimum": 0.001, "maximum": 3600 },
                "required": { "type": "boolean" },
                "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
                "loop": { "$ref": "#/$defs/loop" }
            }
        },
        "variation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clip"],
            "properties": {
                "clip": { "$ref": "#/$defs/stableId" },
                "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
            }
        },
        "ducking": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "gainDb"],
            "properties": {
                "group": { "enum": ["gameplay", "ui", "ambience", "bgm"] },
                "gainDb": { "type": "number", "minimum": -60, "maximum": 0 },
                "attackMs": { "type": "number", "minimum": 0, "maximum": 5000 },
                "releaseMs": { "type": "number", "minimum": 0, "maximum": 10000 }
            }
        },
        "cue": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "kind", "clips"],
            "properties": {
                "group": { "enum": ["gameplay", "ui", "ambience", "bgm"] },
                "kind": { "enum": ["one-shot", "loop"] },
                "required": { "type": "boolean" },
                "clips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variation" } },
                "spatial": { "enum": ["none", "world"] },
                "gainDb": { "type": "number", "minimum": -60, "maximum": 6 },
                "maxVoices": { "type": "integer", "minimum": 1, "maximum": 32 },
                "retriggerCooldownMs": { "type": "number", "minimum": 0, "maximum": 5000 },
                "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
                "pitchRandomizationPercent": { "type": "number", "minimum": 0, "maximum": 5 },
                "gainRandomizationDb": { "type": "number", "minimum": 0, "maximum": 3 },
                "minGainDb": { "type": "number", "minimum": -60, "maximum": 0 },
                "transitionMs": { "type": "number", "minimum": 0, "maximum": 5000 },
                "ducking": { "type": "array", "items": { "$ref": "#/$defs/ducking" } }
            }
        }
    }
}
