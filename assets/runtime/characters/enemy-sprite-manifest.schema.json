{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "enemy-sprite-manifest.schema.json",
    "title": "Baeseongjin enemy sprite manifest v4",
    "type": "object",
    "additionalProperties": false,
    "required": ["formatVersion", "id", "atlases", "enemies"],
    "properties": {
        "$schema": { "type": "string" },
        "formatVersion": { "const": 4 },
        "id": { "type": "string", "minLength": 1 },
        "generator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool"],
            "properties": {
                "tool": { "type": "string", "minLength": 1 },
                "exportVersion": { "type": ["string", "null"] },
                "sourceExport": { "type": "string" }
            }
        },
        "atlases": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/atlas" }
        },
        "aliases": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "enemies": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/enemy" }
        }
    },
    "$defs": {
        "size": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 }
            }
        },
        "point": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
        },
        "atlas": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image", "size", "frameSize"],
            "properties": {
                "image": { "type": "string", "pattern": "\\.png$" },
                "size": { "$ref": "#/$defs/size" },
                "frameSize": { "$ref": "#/$defs/size" }
            }
        },
        "frame": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atlas", "cell", "durationMs"],
            "properties": {
                "atlas": { "type": "string", "minLength": 1 },
                "cell": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["column", "row"],
                    "properties": {
                        "column": { "type": "integer", "minimum": 0 },
                        "row": { "type": "integer", "minimum": 0 }
                    }
                },
                "durationMs": { "type": "integer", "minimum": 1 }
            }
        },
        "state": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["frames"],
                    "properties": {
                        "loop": { "type": "boolean" },
                        "frames": {
                            "type": "array",
                            "minItems": 1,
                            "items": { "$ref": "#/$defs/frame" }
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fallback"],
                    "properties": { "fallback": { "type": "string", "minLength": 1 } }
                }
            ]
        },
        "aimLayer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["orientation", "atlas", "cell"],
            "properties": {
                "orientation": { "const": "upright-aim" },
                "atlas": { "type": "string", "minLength": 1 },
                "cell": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["column", "row"],
                    "properties": {
                        "column": { "type": "integer", "minimum": 0 },
                        "row": { "type": "integer", "minimum": 0 }
                    }
                }
            }
        },
        "layerFrame": {
            "type": "object",
            "additionalProperties": false,
            "required": ["atlas", "cell"],
            "properties": {
                "atlas": { "type": "string", "minLength": 1 },
                "cell": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["column", "row"],
                    "properties": {
                        "column": { "type": "integer", "minimum": 0 },
                        "row": { "type": "integer", "minimum": 0 }
                    }
                }
            }
        },
        "guardLayer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["orientation", "frames"],
            "properties": {
                "orientation": { "const": "guard-octants" },
                "frames": {
                    "type": "array",
                    "minItems": 8,
                    "maxItems": 8,
                    "items": { "$ref": "#/$defs/layerFrame" }
                }
            }
        },
        "enemy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["render", "states"],
            "properties": {
                "render": {
                    "type": "object",
                    "additionalProperties": false,
                    "not": { "required": ["aimLayer", "guardLayer"] },
                    "required": ["facing", "size", "anchor", "offset", "pixelSnap"],
                    "properties": {
                        "facing": { "const": "right" },
                        "size": { "$ref": "#/$defs/size" },
                        "anchor": { "$ref": "#/$defs/point" },
                        "offset": { "$ref": "#/$defs/point" },
                        "pixelSnap": { "type": "boolean" },
                        "aimLayer": { "$ref": "#/$defs/aimLayer" },
                        "guardLayer": { "$ref": "#/$defs/guardLayer" }
                    }
                },
                "states": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "$ref": "#/$defs/state" }
                }
            }
        }
    }
}
