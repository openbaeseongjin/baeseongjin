  "acceptanceTests": [
    {
      "id": "area-spec-schema-valid-after-new-system-support",
      "type": "schema",
      "requirement": "AREA-SPEC REV1.1을 유지하면서 sector04-persistent-guard-v1 및 care-treatment-pod-v1 preset/authoring extension이 validator에 명시적으로 지원되어야 한다.",
      "automation": "AUTOMATED"
    },
    {
      "id": "mandatory-route-clear-zero-impulse",
      "type": "geometry",
      "requirement": "Treatment Pod를 사용하지 않고 swingImpulse=0에서도 route.mandatory가 성립해야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "base-rope-static-reach",
      "type": "geometry",
      "requirement": "A1~A5 필수 Hook은 Base Rope 400px 안에서 충분한 margin을 유지해야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "three-distinct-patrol-silhouettes",
      "type": "runtime",
      "requirement": "A=Reception Ring, B=Cross-Atrium X Loop, C=Recovery Gallery Zigzag로 발각 전 이동 silhouette가 서로 달라야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "persistent-pursuit-three-stack",
      "type": "runtime",
      "requirement": "A/B/C가 모두 발각되고 생존하면 최대 3 Pursuers가 Exit band까지 누적될 수 있어야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "treatment-pod-channel",
      "type": "runtime",
      "requirement": "Pod는 Player 상호작용 후 3.0초 채널링 완료 시 현재 HP에 +40을 더하되 100을 넘지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "treatment-pod-damage-interrupt",
      "type": "runtime",
      "requirement": "치료 채널링 중 Player가 유효한 HP damage를 받으면 치료가 중단되고 회복은 적용되지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "treatment-pod-alert-persists",
      "type": "runtime",
      "requirement": "Pod 사용 시작/중단/완료 어느 시점에도 Persistent Pursuit Alert가 초기화되지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "treatment-pod-no-safe-room",
      "type": "runtime",
      "requirement": "Alerted Guard A/B가 Treatment Deck까지 도달할 수 있고 Pod 사용이 Enemy movement/attack/despawn을 막지 않아야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "treatment-pod-per-player-use",
      "type": "multiplayer",
      "requirement": "Pod 사용 소모 상태는 Player별 1회이며 한 Player 사용이 다른 Player의 사용권을 제거하지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "treatment-pod-authority",
      "type": "multiplayer",
      "requirement": "채널 시작/중단/완료, Player별 사용 상태, HP 회복 결과는 authoritative simulation에서 결정되어야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "three-pursuer-treatment-survivability",
      "type": "traversal",
      "requirement": "3 Pursuer worst case는 어렵지만 읽을 수 있어야 하며, Pod 사용을 강제하지 않고 치료를 포기하고 Base Rope로 탈출할 수 있어야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "augment-regression",
      "type": "regression",
      "requirement": "Combat Augment는 Guard 정리 효율, Movement Augment는 outrun/Pod 접근 효율만 높이고 Pod나 Stage clear에 필수가 되지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "camera-treatment-readability",
      "type": "camera",
      "requirement": "Treatment Deck에서 Pod, 접근 중인 Pursuer, 다음 A4 방향을 동시에 읽을 수 있어야 한다.",
      "automation": "MANUAL"
    }
  ]
}