  "acceptanceTests": [
    {
      "id": "schema-valid-after-moving-anchor-extension",
      "type": "schema",
      "requirement": "AREA-SPEC REV1.1을 유지하면서 sector04-persistent-guard-v1과 moving-anchor-drone-v1의 approved validator/authoring extension이 명시적으로 지원되어야 한다.",
      "automation": "AUTOMATED"
    },
    {
      "id": "mandatory-route-clear-zero-impulse",
      "type": "geometry",
      "requirement": "Moving Anchor Drone 없이 swingImpulse=0에서도 route.mandatory가 성립해야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "base-rope-static-links",
      "type": "geometry",
      "requirement": "A1~A5 static mandatory Hook은 Base Reach 400 안에서 충분한 margin을 유지한다.",
      "automation": "MANUAL"
    },
    {
      "id": "anchor-drone-whole-path-in-base-reach",
      "type": "geometry",
      "requirement": "Atrium Read launch sample에서 Anchor Drone grapple socket의 양 끝 위치가 모두 Base Reach 400 안에 있고 최소 약 100px 정적 margin을 유지한다.",
      "automation": "MANUAL"
    },
    {
      "id": "orbit-phase-pair",
      "type": "runtime",
      "requirement": "Guard A/B는 동일 Diamond Loop와 speed를 공유하고 0.5 phase offset을 유지하여 움직이는 Security Window를 만든다.",
      "automation": "MANUAL"
    },
    {
      "id": "orbit-breaks-on-alert",
      "type": "runtime",
      "requirement": "A/B 중 발각된 Guard만 Orbit을 떠나 Persistent Pursuit로 전환하고, 미발각 Guard는 authored Orbit을 계속 수행한다.",
      "automation": "MANUAL"
    },
    {
      "id": "moving-anchor-targeting",
      "type": "runtime",
      "requirement": "기존 Rope input으로 dynamic grapple socket을 조준할 수 있고 static surface와 동일한 입력 철학을 유지한다.",
      "automation": "MANUAL"
    },
    {
      "id": "moving-anchor-hook-flight-tracking",
      "type": "runtime",
      "requirement": "Moving Anchor 대상 Hook은 비행 중 현재 socket 위치를 추적하며 hookSpeed/flight lifetime/reach 제한을 우회하지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "moving-anchor-fixed-length-constraint",
      "type": "runtime",
      "requirement": "부착 후 Rope length는 hit 순간 길이로 고정되고, moving socket position/velocity를 사용해 상대 방사속도 constraint를 만족한다.",
      "automation": "MANUAL"
    },
    {
      "id": "moving-anchor-release",
      "type": "runtime",
      "requirement": "Release는 기존 Rope release/reload와 동일하고 Moving Anchor 전용 추가 boost를 만들지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "moving-anchor-multiattach",
      "type": "multiplayer",
      "requirement": "여러 Player가 같은 Drone에 부착 가능하며 Player Rope tension이 Drone path/speed를 변경하지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "moving-anchor-authority",
      "type": "multiplayer",
      "requirement": "Drone transform과 dynamic socket position/velocity는 authoritative simulation에서 결정되고 client가 독립적인 anchor motion을 추가하지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "three-pursuer-ceiling",
      "type": "traversal",
      "requirement": "Worst case는 A+B+C 3 Pursuers이며 네 번째 Guard를 추가하지 않는다. Base mandatory route는 여전히 읽히고 생존 가능해야 한다.",
      "automation": "MANUAL"
    },
    {
      "id": "augment-regression",
      "type": "regression",
      "requirement": "Long Rope 480/Fast Recover/Release Propulsion/Direction Dash는 Moving Anchor 표현력을 높일 수 있지만 mandatory가 아니며 Atrium interaction band 전체를 bypass하지 않는다.",
      "automation": "MANUAL"
    },
    {
      "id": "camera-moving-window-readability",
      "type": "camera",
      "requirement": "Atrium Read에서 A/B phase, Anchor Drone, next static Anchor A3를 동시에 읽을 수 있어야 한다.",
      "automation": "MANUAL"
    }
  ]
}