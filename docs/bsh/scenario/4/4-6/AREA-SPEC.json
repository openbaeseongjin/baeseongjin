  "acceptanceTests": [
    {
      "id": "schema-valid-after-authoring-support",
      "type": "schema",
      "requirement": "Official AREA-SPEC contract must explicitly support the persistent-guard and Cutter authoring presets before repo integration.",
      "automation": "AUTOMATED"
    },
    {
      "id": "mandatory-route-current-base-rope",
      "type": "geometry",
      "requirement": "The mandatory route must remain attachable with the current effective Base Rope configuration and must not depend on debug tuning or an Augment.",
      "automation": "MANUAL"
    },
    {
      "id": "mandatory-route-zero-swing-impulse",
      "type": "traversal",
      "requirement": "The approved mandatory chain must be grayboxed with swingImpulse=0.",
      "automation": "MANUAL"
    },
    {
      "id": "cutter-rope-priority",
      "type": "runtime",
      "requirement": "A cutter projectile overlapping an attached Rope resolves as rope-cut before body hit and applies the existing Rope-disabled punishment.",
      "automation": "MANUAL"
    },
    {
      "id": "cutter-drop-recovery",
      "type": "traversal",
      "requirement": "Representative Cutter rope-cuts on the A3/A4 beat must have a recoverable fall outcome rather than deterministic death.",
      "automation": "MANUAL"
    },
    {
      "id": "persistent-guard-through-cutter-band",
      "type": "runtime",
      "requirement": "An alerted Guard A can remain in pursuit while the Player enters the Cutter band; Cutter Read must not reset Alert.",
      "automation": "MANUAL"
    },
    {
      "id": "upper-guard-stack",
      "type": "runtime",
      "requirement": "Guard B can add upper-bridge pressure while Guard A is alive, with total authored hostiles capped at three including Cutter.",
      "automation": "MANUAL"
    },
    {
      "id": "kill-optional",
      "type": "traversal",
      "requirement": "The Stage must be clearable without killing Cutter, Guard A, or Guard B.",
      "automation": "MANUAL"
    },
    {
      "id": "augment-regression",
      "type": "regression",
      "requirement": "Current Rope and action Augments may change retry or combat efficiency but cannot become required or delete the Cutter/Pursuit interaction band.",
      "automation": "MANUAL"
    },
    {
      "id": "camera-threat-readability",
      "type": "camera",
      "requirement": "Cutter Read must show Cutter source, current grapple target, recovery catch and incoming pursuit pressure clearly enough for a commit decision.",
      "automation": "MANUAL"
    }
  ]
