{
    "name": "baeseongjin-rope-roguelike",
    "version": "0.72.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node scripts/serve.mjs",
        "start:multiplayer": "node scripts/multiplayer-server.mjs",
        "start:game-server": "node scripts/multiplayer-server.mjs --game-only --host=0.0.0.0 --port=4175",
        "share:multiplayer": "node scripts/share-multiplayer.mjs",
        "publish:multiplayer": "node scripts/publish-multiplayer.mjs",
        "smoke:multiplayer": "node scripts/smokeMultiplayer.mjs",
        "simulate:multiplayer-combat": "node scripts/simulateTwoPlayerCombat.mjs && node scripts/simulateTwoPlayerCombatWire.mjs",
        "simulate:multiplayer-combat:coverage": "node scripts/simulateTwoPlayerCombatWire.mjs --coverage",
        "simulate:multiplayer-combat:wire": "node scripts/simulateTwoPlayerCombatWire.mjs",
        "test": "node tests/sector03BackgroundTransition.mjs",
        "check": "node scripts/checkSyntax.mjs && node scripts/validateAreaSpecs.mjs && node scripts/area-authoring-v2/generateAreaCatalogs.mjs --check && node scripts/map-editor/validateBossStageSpecs.mjs && node scripts/validateProductionMapParity.mjs && node scripts/validateDirectionSpecs.mjs && node scripts/checkScenarioIntegration.mjs",
        "check:scenario-integration": "node scripts/checkScenarioIntegration.mjs",
        "validate:area-specs": "node scripts/validateAreaSpecs.mjs",
        "validate:production-map-parity": "node scripts/validateProductionMapParity.mjs",
        "validate:sprite-assets": "node scripts/validateSpriteAssets.mjs",
        "validate:enemy-sprite-assets": "node scripts/validateEnemySpriteAssets.mjs",
        "validate:environment-assets": "node scripts/validateEnvironmentAssets.mjs",
        "validate:audio-assets": "node scripts/validateAudioAssets.mjs",
        "validate:direction-specs": "node scripts/validateDirectionSpecs.mjs",
        "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.mjs\" \"tools/**/*.{js,html,css}\" \"*.html\"",
        "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.mjs\" \"tools/**/*.{js,html,css}\" \"*.html\""
    },
    "dependencies": {
        "ws": "8.21.3"
    },
    "devDependencies": {
        "prettier": "^3.8.4"
    }
}
