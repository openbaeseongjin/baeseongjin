# Discord application (never commit the real token)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_MEETING_CHANNEL_ID=
DISCORD_MINUTES_CHANNEL_ID=
# Optional role allowed to start/end meetings. Without it, Manage Server is required.
DISCORD_OPERATOR_ROLE_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_SUMMARY_MODEL=gpt-5.4-mini

# GitHub: use GITHUB_TOKEN, or all three GitHub App variables below.
GITHUB_REPOSITORY=openbaeseongjin/baeseongjin
GITHUB_BRANCH=main
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# This repository and docs/ are public. Set true only after the team approves
# publishing meeting minutes to a public GitHub repository and GitHub Pages.
ALLOW_PUBLIC_GITHUB_MINUTES=false

# Runtime
MEETING_DATA_DIR=.data
RETAIN_AUDIO=false
LOG_LEVEL=info
