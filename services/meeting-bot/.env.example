# Discord application (never commit the real token)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_MEETING_CHANNEL_ID=
DISCORD_MINUTES_CHANNEL_ID=
# Optional role allowed to run /codex. Without it, /codex requires Manage Server.
# /meeting remains available to every member in the configured guild and meeting channel.
DISCORD_OPERATOR_ROLE_ID=

# Free local speech-to-text (no API key or per-use fee)
LOCAL_TRANSCRIPTION_MODEL=tiny
# Optional override. Blank uses .venv/Scripts/python.exe on Windows or .venv/bin/python elsewhere.
LOCAL_WHISPER_PYTHON=
LOCAL_MODEL_CACHE_DIR=.data/models

# GitHub: use GITHUB_TOKEN, or all three GitHub App variables below.
GITHUB_REPOSITORY=openbaeseongjin/baeseongjin
GITHUB_BRANCH=main
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# This repository and docs/ are public. Set true only after the team approves
# publishing meeting minutes to a public GitHub repository and GitHub Pages.
ALLOW_PUBLIC_GITHUB_MINUTES=false

# Runtime
MEETING_DATA_DIR=.data
RETAIN_AUDIO=false
LOG_LEVEL=info

# Discord -> Codex -> Discord planning gateway. Disabled until locally validated.
# Uses repository skills with either the Codex CLI or a local Ollama model.
# It never reads OPENAI_API_KEY. The `codex` provider may consume account quota.
CODEX_ENABLED=false
CODEX_BIN=codex
# `codex` may use account quota. `ollama` and `lmstudio` are local providers.
CODEX_PROVIDER=codex
# Required when selecting a local model explicitly, for example qwen2.5:7b-instruct.
CODEX_MODEL=
# Relative to services/meeting-bot when running npm scripts.
CODEX_REPOSITORY_ROOT=../..
CODEX_MAX_CONTEXT_MESSAGES=30
CODEX_MAX_CONTEXT_CHARACTERS=20000
CODEX_JOB_TIMEOUT_MS=600000
